{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Key accounts workflows API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "workflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Workflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/workflows",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ]
          },
          "docs": "Retrieve a paginated list of workflows.\n\nSupports:\n- Pagination (`page_size`, `page`)\n- Sorting (`order_by`, default: asc)\n"
        },
        {
          "info": {
            "name": "Get Workflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/workflows/:workflowId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "workflowId",
                "value": "",
                "type": "path",
                "description": "Workflow identifier"
              }
            ]
          },
          "docs": "Retrieve details of a specific workflow"
        }
      ]
    }
  ],
  "bundled": true
}