              }
            ],
            "params": [
              {
                "name": "billId",
                "value": "",
                "type": "path",
                "description": "Bill identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Record a manual payment against a bill.\n\n**Request body**\n- `amount`: Positive number in **dollars**\n- `paymentDate`: ISO 8601 datetime string\n- `paymentMethod`: One of `CASH`, `ACH`, `CREDIT_CARD`, `KLARNA`, `AFFIRM`, `CHECK`\n- `notes` (optional)\n- `paymentReference` (optional)\n"
        },
        {
          "info": {
            "name": "Get Bill Payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/bills/:billId/payments/:paymentId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "billId",
                "value": "",
                "type": "path",
                "description": "Bill identifier"
              },
              {
                "name": "paymentId",
                "value": "",
                "type": "path",
                "description": "Payment record identifier"
              }
            ]
          },
          "docs": "Retrieve a single payment record on a bill by payment id.\n\nCore does not expose a standalone payment-record GET; this resolves the payment from the bill's nested payment records.\n"
        }
      ]
    }
  ],
  "bundled": true
}