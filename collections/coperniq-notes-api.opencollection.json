  },
  "items": [
    {
      "info": {
        "name": "notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Project Notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/projects/:projectId/notes",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project identifier"
              }
            ]
          },
          "docs": "Retrieve notes for a specific project\n\n**Note:** The `/projects/{projectId}/comments` path will continue to work until users are individually notified and migrated to the new naming.\n"
        },
        {
          "info": {
            "name": "Create Project Note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coperniq.io/v1/projects/:projectId/notes",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Project identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new note on a project\n\n**Note:** The `/projects/{projectId}/comments` path will continue to work until users are notified and migrated to the new naming.\n"
        },
