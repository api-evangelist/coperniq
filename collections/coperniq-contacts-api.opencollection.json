{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Key accounts contacts API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "contacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/contacts",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query",
                "description": "Filter items updated after this timestamp (ISO 8601)"
              },
              {
                "name": "updated_before",
                "value": "",
                "type": "query",
                "description": "Filter items updated before this timestamp (ISO 8601)"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query",
                "description": "Sort order for results"
              },
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Full text search across contact name, emails, and phones."
              }
            ]
          },
          "docs": "Retrieve a paginated list of contacts.\n\nSupports:\n- Pagination (`page_size`, `page`)\n- Date filtering (`updated_after`, `updated_before`)\n- Sorting (`order_by`)\n- Search (`q`)\n"
        },
        {
          "info": {
            "name": "Create Contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coperniq.io/v1/contacts",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new contact.\n\nRequired fields:\n- `name`: Contact's full name\n\nOptional fields:\n- `phones`: Array of contact phone numbers\n- `emails`: Array of contact email addresses\n- `title`: Contact title\n- `accountIds`: Array of account IDs to associate\n- `projectIds`: Array of project IDs to associate\n"
        },
        {
          "info": {
            "name": "Get Contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/contacts/:contactId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact identifier"
              }
            ]
          },
          "docs": "Retrieve a specific contact by ID"
        },
        {
          "info": {
            "name": "Update Contact",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.coperniq.io/v1/contacts/:contactId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing contact. Supports partial updates.\n\nUpdatable fields:\n- `name`: Contact's full name\n- `phones`: Array of contact phone numbers\n- `emails`: Array of contact email addresses\n- `title`: Contact title\n- `accountIds`: Array of account IDs to associate\n- `projectIds`: Array of project IDs to associate\n"
        },
        {
          "info": {
            "name": "Delete Contact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.coperniq.io/v1/contacts/:contactId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path",
                "description": "Contact identifier"
              }
            ]
          },
          "docs": "Delete a specific contact by ID"
        }
      ]
    }
  ],
  "bundled": true
}