              }
            ],
            "params": [
              {
                "name": "billId",
                "value": "",
                "type": "path",
                "description": "Bill identifier"
              }
            ]
          },
          "docs": "Delete a specific bill by ID.\n\nThe bill is automatically archived before deletion — no separate archive step is required.\n"
        },
