{
  "opencollection": "1.0.0",
  "info": {
    "name": "API Key accounts assets API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "assets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/assets",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              },
              {
                "name": "order_by",
                "value": "",
                "type": "query"
              },
              {
                "name": "account_id",
                "value": "",
                "type": "query",
                "description": "Filter to assets belonging to a specific account."
              },
              {
                "name": "site_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "manufacturer",
                "value": "",
                "type": "query",
                "description": "Case-insensitive substring match on `manufacturer`."
              },
              {
                "name": "is_archived",
                "value": "",
                "type": "query",
                "description": "Filter by archive state. Accepts `true` / `false` / `1` / `0`."
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query"
              },
              {
                "name": "updated_before",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List assets for the authenticated company. Supports pagination and filters (`account_id`, `site_id`, `status`, `type`, `manufacturer`, `is_archived`, date range on `updated_at`).\n"
        },
        {
          "info": {
            "name": "Create Asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coperniq.io/v1/assets",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new asset. Requires `accountId`, `siteId`, `type`, `manufacturer`, `model`, and `serialNumber`."
        },
        {
          "info": {
            "name": "Get Asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/assets/:assetId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a specific asset by ID."
        },
        {
          "info": {
            "name": "Update Asset",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.coperniq.io/v1/assets/:assetId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "assetId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing asset. All fields are optional — only include what you want to change.\n\n`siteId` and `accountId` cannot be changed after creation. Including either field in the request body is rejected with a `400 Bad Request` validation error.\n\nTo archive an asset, set `isArchived: true`. To unarchive, set `isArchived: false`.\n"
        }
      ]
    }
  ],
  "bundled": true
}