      "items": [
        {
          "info": {
            "name": "List Labels",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/labels",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by label type"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "Number of items per page (max 100)"
              }
            ]
          },
          "docs": "Lists active labels for your company. Labels can be applied to work orders (`WORK` type) or assets (`ASSET` type).\nThe company is implied by the API key.\n"
        },
        {
          "info": {
            "name": "Create Label",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.coperniq.io/v1/labels",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new label for the company. Use `WORK` for work-order labels or `ASSET` for asset labels.\n"
        },
        {
          "info": {
            "name": "Get Label",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.coperniq.io/v1/labels/:labelId",
            "headers": [
              {
                "name": "x-api-key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "labelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve a single label by ID."
        }
      ]
    }
  ],
