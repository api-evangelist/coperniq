          "name": "Replace Work Order Line Items",
          "request": {
            "name": "Replace Work Order Line Items",
            "description": {
              "content": "Replaces all line items on a work order. Internally updates or creates the underlying quote linked to the task.\n\nSupported **only** for service work orders on an **account** (parent project type `ACCOUNT`). Requests for other work orders receive `400`.\n\nProvide **either** `sections` **or** `lineItems` (not both), using the same shapes as quote line items.\n",
              "type": "text/plain"
            },
            "url": {
